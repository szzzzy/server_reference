{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "虚拟服务器 (stub 协议测试)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv_vs\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\virtual_server\\run_server.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "虚拟服务器 (real 一问一答)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv_5090_llm\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\virtual_server\\run_server.py",
      "args": ["--voice-mode", "real", "--tty"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "板卡模拟器 (全场景验收)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv_5090_llm\\Scripts\\python.exe",
      "program": "${workspaceFolder}\\virtual_server\\board_simulator.py",
      "args": ["--scenario", "all"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
