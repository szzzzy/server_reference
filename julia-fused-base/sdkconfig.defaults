# Default sdkconfig parameters to use the OTA.
# The project targets a 16 MiB SPI flash and uses a custom table based on the
# official ESP-IDF two-OTA layout, expanded to fill the available capacity.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# ESP-SR: 本地唤醒词（WakeNet "你好小智"，wn9_nihaoxiaozhi_tts）+ AFE 音频前端。
# 模型由 esp-sr 组件构建时自动打包进 "model" spiffs 分区（0x400000）。
CONFIG_USE_AFE=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_USE_WAKENET=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# The 16 MiB table reserves 4 MiB for WakeNet models, leaving a 3 MiB FAT
# audio-data partition. Never accept an artifact larger than that partition.
CONFIG_AUDIO_MAX_FILE_SIZE=3145728

# Enable bootloader-managed first-boot validation and rollback.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Communication reliability defaults. Credentials are intentionally omitted and must be
# injected through a protected provisioning/build flow for production devices.
CONFIG_COMM_HEARTBEAT_INTERVAL_SECONDS=60
CONFIG_COMM_RECONNECT_INTERVAL_SECONDS=10
CONFIG_COMM_DEVICE_AUTH_USERNAME_PASSWORD=y
CONFIG_OTA_CHECK_RESPONSE_TIMEOUT_SECONDS=15
CONFIG_OTA_CHECK_RESPONSE_RETRY_COUNT=2
CONFIG_OTA_CHECK_RESPONSE_RETRY_BASE_SECONDS=2
CONFIG_OTA_CHECK_RESPONSE_RETRY_MAX_SECONDS=10
CONFIG_OTA_CHECK_RECOVERY_INITIAL_SECONDS=30
CONFIG_OTA_CHECK_RECOVERY_MAX_SECONDS=300
CONFIG_COMM_MQTT_SUBACK_TIMEOUT_SECONDS=15

# WSS voice stream keepalive: idle links are healthy; liveness is probed with
# client PINGs and only a missing PONG tears the link down.
CONFIG_WSS_KEEPALIVE_INTERVAL_SECONDS=15
CONFIG_WSS_PONG_TIMEOUT_SECONDS=10

# Voice push demo (device-initiated) is DISABLED by default: the WSS session is
# driven by the cloud server (server sends FILE_SEND, device pushes the file).
# Set CONFIG_VOICE_PUSH_DEMO_ENABLE=y to also test unsolicited device-initiated
# pushes (see voice_push_demo.c).

# SD card (SDMMC 1-bit, Waveshare ESP32-S3-LCD-1.85): CLK=IO14, CMD=IO17,
# D0=IO16; D3/CS via the on-board TCA9554 P2 (Extend_IO3, I2C SCL=IO10/SDA=IO11,
# addr 0x20). Mounted at /sdcard for SD:/ URIs. Proven by the VOICE DATA
# BENCHMARK 08_sd_tool project on the same board.
CONFIG_SD_CARD_ENABLE=y
CONFIG_SD_CARD_PIN_CLK=14
CONFIG_SD_CARD_PIN_CMD=17
CONFIG_SD_CARD_PIN_D0=16
CONFIG_SD_CARD_I2C_SCL=10
CONFIG_SD_CARD_I2C_SDA=11
CONFIG_SD_CARD_FREQ_KHZ=20000

# OTA transport failures remain retryable. After the threshold, use a bounded,
# persistent cooldown instead of permanently quarantining the artifact.
CONFIG_OTA_DOWNLOAD_RETRY_THRESHOLD=3
CONFIG_OTA_DOWNLOAD_COOLDOWN_BASE_SECONDS=60
CONFIG_OTA_DOWNLOAD_COOLDOWN_MAX_SECONDS=3600

# TCP WebSocket transport is not part of this application.
# CONFIG_WS_TRANSPORT is not set
# Wi-Fi remains a background service.  Retry timing is configured by the
# application lifecycle manager rather than the example component's finite
# synchronous retry loop.
CONFIG_NETWORK_WIFI_RETRY_BASE_MS=1000
CONFIG_NETWORK_WIFI_RETRY_MAX_MS=60000
CONFIG_NETWORK_WIFI_RETRY_JITTER_PERCENT=20
CONFIG_EXAMPLE_WIFI_CONN_MAX_RETRY=-1
